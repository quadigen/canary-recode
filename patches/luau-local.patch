diff --git a/Common/include/Luau/Common.h b/Common/include/Luau/Common.h
index 15c2f571..ad274053 100644
--- a/Common/include/Luau/Common.h
+++ b/Common/include/Luau/Common.h
@@ -90,8 +90,15 @@ struct FValue
         : value(def)
         , dynamic(dynamic)
         , name(name)
-        , next(list)
+        , next(nullptr)
     {
+        // Relocatable WebAssembly links may retain a constructor more than once.
+        // Never splice the same flag object back onto its own intrusive list.
+        for (FValue* flag = list; flag; flag = flag->next)
+            if (flag == this)
+                return;
+
+        next = list;
         list = this;
     }
 
