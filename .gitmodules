[submodule "vendor/manifold"]
	path = vendor/manifold
	url = https://github.com/elalish/manifold.git
[submodule ".tools/emsdk"]
	path = .tools/emsdk
	url = https://github.com/emscripten-core/emsdk.git
[submodule "vendor/libyaml"]
	path = vendor/libyaml
	url = https://github.com/yaml/libyaml
[submodule "vendor/miniz"]
	path = vendor/miniz
	url = https://github.com/richgel999/miniz
[submodule "vendor/tracy"]
	path = vendor/tracy
	url = https://github.com/wolfpld/tracy
[submodule "vendor/zstd"]
	path = vendor/zstd
	url = https://github.com/facebook/zstd.git
[submodule "vendor/webview"]
	path = vendor/webview
	url = https://github.com/webview/webview
[submodule "vendor/Ray"]
	path = vendor/Ray
	url = https://github.com/sergcpp/Ray.git
[submodule "vendor/rocksdb"]
	path = vendor/rocksdb
	url = https://github.com/meta/rocksdb
[submodule "vendor/filament-compiler-source"]
	path = vendor/filament-compiler-source
	url = https://github.com/google/filament.git
