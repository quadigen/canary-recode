Material_Is_Valid :: proc(value: int) -> bool {return value >= 0 && value < MATERIAL_COUNT}
Material_Roblox_Value :: proc(material: Material) -> i64 {
	if !Material_Is_Valid(int(material)) {return -1}
	return Material_Roblox_Values[int(material)]
}
Material_From_Roblox_Value :: proc(value: i64) -> (Material, bool) {
	for material in Material_Public_Order {if Material_Roblox_Value(material) == value {return material, true}}
	return .SmoothPlastic, false
}
