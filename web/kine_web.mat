material {
    name : "KinemiumWeb",
    shadingModel : lit,
    blending : opaque,
    requires : [ uv0 ],
    parameters : [
        { type : float4,    name : baseColor },
        { type : float,     name : hasTexture },
        { type : sampler2d, name : baseColorMap },
        { type : float2,    name : uvScale },
        { type : float,     name : roughness },
        { type : float,     name : metallic },
        { type : float,     name : shadowStrength }
    ]
}
fragment {
    void material(inout MaterialInputs material) {
        // Lit, so the shading model consumes the geometry normal the web shell
        // uploads (NORMAL) and receives shadows from the sun light. Surface
        // controls are material parameters rather than the native shim's
        // per-instance arrays because the web draws one entity per part.
        prepareMaterial(material);
        vec4 color = materialParams.baseColor;
        if (materialParams.hasTexture > 0.5) {
            vec2 scale = materialParams.uvScale;
            if (scale.x <= 0.0001) { scale = vec2(1.0); }
            color *= texture(materialParams_baseColorMap, getUV0() * scale);
        }
        material.baseColor = color;
        material.roughness = materialParams.roughness;
        material.metallic = materialParams.metallic;
        material.shadowStrength = materialParams.shadowStrength;
    }
}
