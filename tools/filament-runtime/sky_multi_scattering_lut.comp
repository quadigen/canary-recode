#version 450
#extension GL_GOOGLE_include_directive : require
#include "kine_sky_atmosphere.glsl"

// Port of WickedEngine/shaders/skyAtmosphere_multiScatteredLuminanceLutCS.hlsl.
// One 32x32 texel stores the second-order luminance of the atmosphere for a sun zenith angle
// and a view height, so the sky pass can approximate all scattering orders with it.
layout(local_size_x = 1, local_size_y = 1, local_size_z = 64) in;

layout(set = 0, binding = 0, std140) uniform AtmosphereParameters {
    vec4 radii;            // (bottomRadius, topRadius, rayleighDensityExpScale, mieDensityExpScale)
    vec4 rayleigh;         // (rayleighScattering rgb, unused)
    vec4 mieScattering;    // (mieScattering rgb, unused)
    vec4 mieExtinction;    // (mieExtinction rgb, unused)
    vec4 absorption;       // (absorptionExtinction rgb, absorptionDensity0LayerWidth)
    vec4 absorptionTerms;  // (layer0 constant, layer0 linear, layer1 constant, layer1 linear)
    vec4 groundAlbedo;     // (ground albedo rgb, unused)
    vec4 lut;              // (sampleCount, unused, unused, unused)
} atmosphere;

layout(set = 0, binding = 1, rgba16f) uniform image2D transmittanceLut;
layout(set = 0, binding = 2, rgba16f) uniform image2D multiScatteringLut;

// One entry per sphere direction; Wicked reduces these 64 directions in groupshared memory.
shared vec3 multiScatAs1SharedMem[64];
shared vec3 luminanceSharedMem[64];

// Compute stages in this runtime have no samplers, so the transmittance LUT is read back with
// imageLoad and filtered manually. This reproduces clamp + bilinear sampling at texel centres.
vec3 sampleTransmittanceLut(KineAtmosphereParameters parameters, float pHeight,
        float sunZenithCosAngle) {
    vec2 uv;
    kineLutTransmittanceParamsToUv(parameters.bottomRadius, parameters.topRadius, pHeight,
            sunZenithCosAngle, uv);

    ivec2 size = imageSize(transmittanceLut);
    vec2 texel = uv * vec2(size) - 0.5;
    ivec2 base = ivec2(floor(texel));
    vec2 fraction = texel - vec2(base);

    ivec2 low = ivec2(0);
    ivec2 high = size - 1;
    vec3 c00 = imageLoad(transmittanceLut, clamp(base, low, high)).rgb;
    vec3 c10 = imageLoad(transmittanceLut, clamp(base + ivec2(1, 0), low, high)).rgb;
    vec3 c01 = imageLoad(transmittanceLut, clamp(base + ivec2(0, 1), low, high)).rgb;
    vec3 c11 = imageLoad(transmittanceLut, clamp(base + ivec2(1, 1), low, high)).rgb;
    return mix(mix(c00, c10, fraction.x), mix(c01, c11, fraction.x), fraction.y);
}

// Subset of IntegrateScatteredLuminance for the multi-scattering LUT: unit illuminance,
// non-variable 20-sample march, uniform phase, no cloud or cascade shadows, no multiple
// scattering lookup, optional ground bounce.
KineScatteringResult integrateScatteredLuminance(KineAtmosphereParameters parameters,
        vec3 worldPosition, vec3 worldDirection, vec3 sunDirection, float sampleCount,
        bool ground) {
    KineScatteringResult result;
    result.L = vec3(0.0);
    result.opticalDepth = vec3(0.0);
    result.transmittance = vec3(1.0);
    result.multiScatAs1 = vec3(0.0);

    if (length(worldPosition) <= parameters.bottomRadius) {
        return result;
    }

    float tBottom = kineRaySphereIntersectNearest(worldPosition, worldDirection,
            parameters.bottomRadius);
    float tTop = kineRaySphereIntersectNearest(worldPosition, worldDirection,
            parameters.topRadius);
    float tMax = 0.0;
    if (tBottom < 0.0) {
        if (tTop < 0.0) {
            return result;
        }
        tMax = tTop;
    } else if (tTop > 0.0) {
        tMax = min(tTop, tBottom);
    }
    tMax = min(tMax, 9000000.0);

    float uniformPhase = kineUniformPhase();
    vec3 L = vec3(0.0);
    vec3 throughput = vec3(1.0);
    vec3 opticalDepth = vec3(0.0);
    float t = 0.0;
    for (float s = 0.0; s < sampleCount; s += 1.0) {
        float newT = tMax * (s + 0.3) / sampleCount;
        float dt = newT - t;
        t = newT;

        vec3 P = worldPosition + t * worldDirection;
        float pHeight = length(P);
        KineMediumSample medium = kineSampleMedium(parameters, P);
        vec3 sampleOpticalDepth = medium.extinction * dt;
        vec3 sampleTransmittance = exp(-sampleOpticalDepth);
        opticalDepth += sampleOpticalDepth;

        vec3 upVector = P / pHeight;
        float sunZenithCosAngle = dot(sunDirection, upVector);
        vec3 transmittanceToSun = sampleTransmittanceLut(parameters, pHeight, sunZenithCosAngle);
        float tEarth = kineRaySphereIntersectNearest(P, sunDirection, parameters.bottomRadius);
        float earthShadow = tEarth >= 0.0 ? 0.0 : 1.0;
        vec3 phaseTimesScattering = medium.scattering * uniformPhase;
        vec3 S = earthShadow * transmittanceToSun * phaseTimesScattering;

        vec3 MS = medium.scattering;
        vec3 MSint = (MS - MS * sampleTransmittance) / medium.extinction;
        result.multiScatAs1 += throughput * MSint;

        vec3 Sint = (S - S * sampleTransmittance) / medium.extinction;
        L += throughput * Sint;
        throughput *= sampleTransmittance;
    }

    if (ground && tMax == tBottom && tBottom > 0.0) {
        vec3 P = worldPosition + tBottom * worldDirection;
        float pHeight = length(P);
        vec3 upVector = P / pHeight;
        float sunZenithCosAngle = dot(sunDirection, upVector);
        vec3 transmittanceToSun = sampleTransmittanceLut(parameters, pHeight, sunZenithCosAngle);
        float NdotL = clamp(dot(upVector, sunDirection), 0.0, 1.0);
        L += transmittanceToSun * throughput * NdotL * parameters.groundAlbedo / KINE_PI;
    }

    result.L = L;
    result.opticalDepth = opticalDepth;
    result.transmittance = throughput;
    return result;
}

void main() {
    uvec3 id = gl_GlobalInvocationID;
    ivec2 size = imageSize(multiScatteringLut);
    if (id.x >= uint(size.x) || id.y >= uint(size.y) || id.z >= 64u) {
        return;
    }

    KineAtmosphereParameters parameters = KineAtmosphereParameters(
            atmosphere.radii.x, atmosphere.radii.y, atmosphere.radii.z, atmosphere.radii.w,
            atmosphere.rayleigh.rgb, atmosphere.mieScattering.rgb, atmosphere.mieExtinction.rgb,
            atmosphere.absorption.rgb, atmosphere.groundAlbedo.rgb, atmosphere.absorption.w,
            atmosphere.absorptionTerms.x, atmosphere.absorptionTerms.y,
            atmosphere.absorptionTerms.z, atmosphere.absorptionTerms.w);

    vec2 uv = (vec2(id.xy) + 0.5) / vec2(size);
    uv = vec2(kineFromSubUvsToUnit(uv.x, float(size.x)),
            kineFromSubUvsToUnit(uv.y, float(size.y)));

    float cosSunZenithAngle = uv.x * 2.0 - 1.0;
    vec3 sunDirection = vec3(0.0,
            sqrt(clamp(1.0 - cosSunZenithAngle * cosSunZenithAngle, 0.0, 1.0)),
            cosSunZenithAngle);
    float viewHeight = atmosphere.radii.x +
            clamp(uv.y + KINE_PLANET_RADIUS_OFFSET, 0.0, 1.0) *
            (atmosphere.radii.y - atmosphere.radii.x - KINE_PLANET_RADIUS_OFFSET);
    vec3 worldPosition = vec3(0.0, 0.0, viewHeight);

    // Wicked covers the sphere with 8x8 directions distributed with a stratified pattern.
    float sqrtSample = 8.0;
    float i = 0.5 + float(id.z / 8u);
    float j = 0.5 + float(id.z - (id.z / 8u) * 8u);
    float randA = i / sqrtSample;
    float randB = j / sqrtSample;
    float theta = 2.0 * KINE_PI * randA;
    float phi = KINE_PI * randB;
    float cosPhi = cos(phi);
    float sinPhi = sin(phi);
    vec3 worldDirection = vec3(cos(theta) * sinPhi, sin(theta) * sinPhi, cosPhi);

    KineScatteringResult result = integrateScatteredLuminance(parameters, worldPosition,
            worldDirection, sunDirection, atmosphere.lut.x, true);

    float sphereSolidAngle = 4.0 * KINE_PI;
    float weight = sphereSolidAngle / (sqrtSample * sqrtSample);
    multiScatAs1SharedMem[id.z] = result.multiScatAs1 * weight;
    luminanceSharedMem[id.z] = result.L * weight;

    barrier();
    for (uint stride = 32u; stride > 0u; stride >>= 1u) {
        if (id.z < stride) {
            multiScatAs1SharedMem[id.z] += multiScatAs1SharedMem[id.z + stride];
            luminanceSharedMem[id.z] += luminanceSharedMem[id.z + stride];
        }
        barrier();
    }

    if (id.z != 0u) {
        return;
    }

    float isotropicPhase = 1.0 / (4.0 * KINE_PI);
    vec3 multiScatAs1 = multiScatAs1SharedMem[0] * isotropicPhase; // Equation 7, f_ms
    vec3 inScatteredLuminance = luminanceSharedMem[0] * isotropicPhase; // Equation 5

    // Power series sum of all scattering orders: 1 + r + r^2 + ... = 1 / (1 - r).
    vec3 r = multiScatAs1;
    vec3 luminance = inScatteredLuminance / (vec3(1.0) - r);

    imageStore(multiScatteringLut, ivec2(id.xy), vec4(luminance, 1.0));
}
