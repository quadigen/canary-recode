#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, std140) uniform CloudMarchParameters {
    vec4 settings;
    vec4 motion;
} params;
layout(set = 0, binding = 1, rgba8) uniform readonly image3D shapeNoise;
layout(set = 0, binding = 2, rgba8) uniform readonly image3D detailNoise;
layout(set = 0, binding = 3, rgba8) uniform readonly image2D curlNoise;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D clouds;

vec4 sampleShape(vec3 p) {
    ivec3 size = imageSize(shapeNoise);
    ivec3 coord = ivec3(fract(p) * vec3(size));
    return imageLoad(shapeNoise, coord);
}

vec4 sampleDetail(vec3 p) {
    ivec3 size = imageSize(detailNoise);
    ivec3 coord = ivec3(fract(p) * vec3(size));
    return imageLoad(detailNoise, coord);
}

vec3 sampleCurl(vec2 p) {
    ivec2 size = imageSize(curlNoise);
    return imageLoad(curlNoise, ivec2(fract(p) * vec2(size))).rgb * 2.0 - 1.0;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(clouds);
    if (any(greaterThanEqual(coord, size))) return;
    vec2 uv = (vec2(coord) + 0.5) / vec2(size);
    vec3 radiance = vec3(0.0);
    float throughput = 1.0;
    float steps = max(1.0, params.settings.z);
    float cover = clamp(params.settings.x, 0.0, 1.0);
    float densityScale = max(params.settings.y, 0.0);
    float sunHeight = clamp(params.settings.w, -1.0, 1.0);
    float threshold = mix(0.72, 0.09, cover);
    for (float i = 0.0; i < steps; i += 1.0) {
        float t = (i + 0.5) / steps;
        vec2 curl = sampleCurl(uv * 3.0 + params.motion.xy * 0.07 + t * 0.3).xy;
        vec3 position = vec3(uv * 2.0 + params.motion.xy * 0.02 +
                curl * params.motion.z * 0.08, t + params.motion.w * 0.003);
        vec4 shape = sampleShape(position);
        vec4 detail = sampleDetail(position * 2.0 + vec3(0.05));
        float base = mix(shape.r, dot(shape.gba, vec3(0.5, 0.3, 0.2)), 0.15);
        float erosion = dot(detail.rgb, vec3(0.5, 0.3, 0.2));
        float vertical = smoothstep(0.0, 0.08, t) * (1.0 - smoothstep(0.82, 1.0, t));
        float density = clamp((base - threshold) * 3.5, 0.0, 1.0) *
                mix(1.0, erosion, 0.22) * vertical * densityScale;
        float absorbed = 1.0 - exp(-density * 0.8 / steps);
        float daylight = mix(0.04, 1.0, clamp(sunHeight * 0.5 + 0.5, 0.0, 1.0));
        vec3 light = vec3(0.9, 0.95, 1.0) * daylight * (0.4 + 0.6 * t);
        radiance += throughput * absorbed * light;
        throughput *= 1.0 - absorbed;
    }
    imageStore(clouds, coord, vec4(radiance, clamp(1.0 - throughput, 0.0, 1.0)));
}
