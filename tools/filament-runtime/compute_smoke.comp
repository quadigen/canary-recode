#version 450
layout(local_size_x = 16) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { uint inputValues[]; };
layout(set = 0, binding = 1, std430) buffer Output { uint outputValues[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < outputValues.length()) {
        outputValues[i] = inputValues[i] * 3u + outputValues[i];
    }
}
