+// Validate the actual resolved socket address, rather than the hostname alone.
+public_endpoint :: proc(endpoint: net.Endpoint) -> bool {
+	switch ip in endpoint.address {
+	case net.IP4_Address:
+		a,b,c := ip[0],ip[1],ip[2]
+		return !(a == 0 || a == 10 || a == 127 || a >= 224 ||
+			(a == 169 && b == 254) || (a == 172 && b >= 16 && b <= 31) ||
+			(a == 192 && (b == 168 || (b == 0 && (c == 0 || c == 2)))) ||
+			(a == 100 && b >= 64 && b <= 127) ||
+			(a == 198 && (b == 18 || b == 19 || (b == 51 && c == 100))) ||
+			(a == 203 && b == 0 && c == 113))
+	case net.IP6_Address:
+		a,b := u16(ip[0]),u16(ip[1])
+		return a >= 0x2000 && a <= 0x3fff && a != 0x2002 &&
+			!(a == 0x2001 && (b <= 0x01ff || b == 0x0db8))
+	}
+	return false
+}
