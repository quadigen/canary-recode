material {
    name : "KineForceField",
    shadingModel : unlit,
    blending : transparent,
    doubleSided : true,
    instanced : true,
    requires : [ uv0 ],
    parameters : [
        { type : float4[64], name : instanceColors },
        { type : sampler2d, name : baseColorMap },
        { type : float, name : hasTexture },
        { type : float, name : time }
    ]
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec3 view = normalize(getWorldCameraPosition()-getWorldPosition());
        vec3 geometricNormal = normalize(cross(dFdx(getWorldPosition()),dFdy(getWorldPosition())));
        float rim = pow(1.0-abs(dot(geometricNormal,view)),2.0);
        float pulse = 0.85+0.15*sin(materialParams.time*2.4+getWorldPosition().y*1.4);
        float mask = 1.0;
        if (materialParams.hasTexture > 0.5) mask = texture(materialParams_baseColorMap,getUV0()).r;
        vec4 tint = materialParams.instanceColors[getInstanceIndex()];
        float alpha = (0.1+rim*0.65)*mask*tint.a;
        material.baseColor = vec4(tint.rgb*(0.65+rim*1.8)*pulse*alpha,alpha);
    }
}
