material {
    name : "kine_hl_outline_top",
    // See kine_hl_outline.mat for why this is lit rather than unlit.
    shadingModel : lit,
    blending : transparent,
    // HighlightDepthMode.AlwaysOnTop: the shell ignores the depth buffer so the
    // outline stays visible through whatever geometry is in front of the part.
    culling : front,
    depthWrite : false,
    depthCulling : false,
    vertexDomain : object,
    instanced : true,
    parameters : [
        { type : float4[64], name : instanceColors },
        { type : float,  name : thickness }
    ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        material.worldPosition.xyz += normalize(material.worldNormal) * materialParams.thickness;
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec4 c = materialParams.instanceColors[getInstanceIndex()];
        material.baseColor.rgb = c.rgb;
        material.baseColor.a = c.a;
        material.emissive.rgb = c.rgb;
        material.emissive.a = c.a;
        material.roughness = 1.0;
        material.metallic = 0.0;
    }
}
