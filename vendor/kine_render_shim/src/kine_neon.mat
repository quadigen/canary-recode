material {
    name : "kine_neon",
    shadingModel : unlit,
    blending : add,
    instanced : true,
    parameters : [
        { type : float4[64], name : instanceColors },
        { type : float,  name : intensity }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor.rgb = materialParams.instanceColors[getInstanceIndex()].rgb * materialParams.intensity;
        material.baseColor.a = 1.0;
    }
}
