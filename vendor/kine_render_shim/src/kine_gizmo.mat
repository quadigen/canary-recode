material {
    name : "KineGizmo",
    shadingModel : unlit,
    blending : opaque,
    culling : none,
    depthWrite : false,
    depthCulling : false,
    instanced : true,
    parameters : [
        { type : float4[64], name : instanceColors }
    ]
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = materialParams.instanceColors[getInstanceIndex()];
    }
}
