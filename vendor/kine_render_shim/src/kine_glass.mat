material {
    name : "kine_glass",
    shadingModel : lit,
    blending : transparent,
    // Cubemap refraction only bends the distant environment. Screen-space
    // refraction also warps opaque scene geometry behind the glass.
    refractionMode : screenspace,
    refractionType : solid,
    instanced : true,
    parameters : [
        { type : float4[64], name : instanceColors },
        { type : float,  name : roughness },
        { type : float,  name : ior },
        { type : float,  name : thickness },
        { type : float,  name : transmission }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec3 c = materialParams.instanceColors[getInstanceIndex()].rgb;
        // Keep the dielectric surface mostly neutral; use absorption below
        // for physically plausible colored transmission through the volume.
        material.baseColor.rgb = 0.82 + 0.18 * c;
        material.roughness     = materialParams.roughness;
        material.ior           = materialParams.ior;
        material.thickness     = materialParams.thickness;
        // BasePart.Transparency is passed as transmission. Use the same value
        // for the blend opacity so Glass has no hidden opacity of its own.
        material.transmission  = materialParams.transmission;
        material.absorption    = (1.0 - clamp(c, 0.0, 1.0)) * 0.15;
        material.baseColor.a   = 1.0 - materialParams.transmission;
    }
}
