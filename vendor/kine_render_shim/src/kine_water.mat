
material {
    name : "kine_water",
    shadingModel : lit,
    blending : transparent,
    refractionMode : screenspace,
    refractionType : solid,
    instanced : true,
    requires : [ uv0 ],
    variables : [ worldWaveNormal ],
    parameters : [
        { type : float4[64], name : instanceColors },
        { type : float,  name : roughness },
        { type : float,  name : ior },
        { type : float,  name : thickness },
        { type : float,  name : transmission },
        { type : float,  name : time },
        { type : float,  name : waveScale },
        { type : float,  name : speed },
        { type : float,  name : strength },
        { type : float,  name : octaves },
        { type : float,  name : height },
        { type : float,  name : foamAmount },
        // Declared so the renderer's per-batch setup can set them: see
        // kine_apply_material_params's KINE_MAT_WATER branch. Filament treats
        // setParameter() on an undeclared name as a precondition violation
        // (utils::PreConditionPanic -> std::terminate), so a name set in C++
        // must exist here or drawing water aborts the process.
        { type : float3, name : absorption },
        { type : float,  name : clearCoat },
        { type : float,  name : clearCoatRoughness }
    ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        mat4 model = getWorldFromModelMatrix();
        vec3 baseWorld = (model * vec4(getPosition().xyz,1.0)).xyz;
        float scale = max(materialParams.waveScale, 0.25);
        vec2 p = baseWorld.xz;
        float time = materialParams.time * materialParams.speed;
        // Identical spectrum and phases to datatypes/WaterWaves.odin.
        vec2 directions[6] = vec2[](vec2(.940,.342),vec2(-.574,.819),vec2(.259,-.966),vec2(-.848,-.530),vec2(.719,.695),vec2(-.196,.981));
        vec3 waves[6] = vec3[](vec3(32,.50,.4),vec3(19,.23,2.1),vec3(11,.13,4.7),vec3(7,.075,1.3),vec3(4,.04,5.5),vec3(2.5,.025,3.2));
        vec3 displacement = vec3(0.0);
        vec3 tangentX = vec3(1,0,0), tangentZ = vec3(0,0,1);
        int count = int(clamp(materialParams.octaves,1.0,6.0));
        for (int i=0;i<count;++i) {
            vec2 d = normalize(directions[i]);
            float k = 6.28318530718/(waves[i].x*scale);
            float amplitude = .65*materialParams.strength*materialParams.height*waves[i].y;
            float horizontal = min(amplitude*.35,.12/k);
            float phase = k*dot(d,p)-sqrt(9.81*k)*time+waves[i].z;
            float s = sin(phase), c = cos(phase);
            displacement += vec3(d.x*horizontal*c,amplitude*s,d.y*horizontal*c);
            tangentX += vec3(-d.x*d.x*horizontal*k*s,d.x*amplitude*k*c,-d.x*d.y*horizontal*k*s);
            tangentZ += vec3(-d.x*d.y*horizontal*k*s,d.y*amplitude*k*c,-d.y*d.y*horizontal*k*s);
        }
        material.worldPosition.xyz += displacement;
        material.worldWaveNormal = vec4(normalize(cross(tangentZ,tangentX)),displacement.y);
    }
}

fragment {
    float waterHash(vec2 p) {
        p = fract(p*vec2(123.34,456.21));
        p += dot(p,p+45.32);
        return fract(p.x*p.y);
    }
    float waterNoise(vec2 p) {
        vec2 cell = floor(p), f = fract(p);
        f = f*f*(3.0-2.0*f);
        return mix(mix(waterHash(cell),waterHash(cell+vec2(1,0)),f.x),
                   mix(waterHash(cell+vec2(0,1)),waterHash(cell+vec2(1,1)),f.x),f.y);
    }
    vec2 waterRipples(vec2 p, float time) {
        // Slow coherent flow breaks up straight wave bands without textures.
        vec2 flow = vec2(waterNoise(p*0.48+vec2(time*0.025,0.0)),
                         waterNoise(p*0.48+vec2(7.3,2.8-time*0.02)));
        p += (flow-0.5)*2.2;
        vec2 gradient = vec2(0);
        vec2 direction = normalize(vec2(1.0,0.38));
        float frequency = 1.8, amplitude = 0.075;
        int count = int(clamp(materialParams.octaves,1.0,32.0));
        for (int i=0; i<count; ++i) {
            float phase = dot(direction,p)*frequency + time*(0.7+float(i)*0.13);
            // Analytic pixel footprint filtering avoids sparkles at a distance.
            float visible = 1.0-smoothstep(0.65,2.8,fwidth(phase));
            gradient += direction*cos(phase)*amplitude*visible;
            p += direction*sin(phase)*0.035;
            direction = vec2(direction.x*0.7986-direction.y*0.6018,
                             direction.x*0.6018+direction.y*0.7986);
            frequency *= 1.75;
            amplitude *= 0.68;
        }
        return gradient;
    }
    void material(inout MaterialInputs material) {
        float time = materialParams.time*materialParams.speed;
        vec2 world = getUserWorldPosition().xz;
        float scale = max(materialParams.waveScale,0.25);
        vec2 p = world*max(materialParams.height,0.05)/scale;
        vec2 detail = waterRipples(p,time);
        vec3 waveNormal = normalize(variable_worldWaveNormal.xyz);
        vec3 N = normalize(waveNormal+vec3(-detail.x,0.0,-detail.y)*min(materialParams.strength,2.0));
        // Filament consumes normal in prepareMaterial, so assign it first.
        material.normal = transpose(getWorldTangentFrame())*N;
        prepareMaterial(material);

        float cloud = waterNoise(p*0.28+vec2(time*0.025,-time*0.018));
        float small = waterNoise(p*2.8+vec2(-time*0.05,time*0.035));
        // Foam follows crests and ripples; tile boundaries have no rim or tint.
        float foam = smoothstep(0.085,0.16,length(detail))*smoothstep(0.65,0.9,small)*0.12;
        foam = saturate(foam*materialParams.foamAmount);

        vec3 tint = clamp(materialParams.instanceColors[getInstanceIndex()].rgb,0.0,1.0);
        // White/default Parts still read as water; authored hues tint the water.
        vec3 colorFilter = mix(vec3(1.0),tint/max(max(tint.r,tint.g),max(tint.b,0.001)),0.65);
        vec3 deepColor = vec3(0.006,0.095,0.40);
        vec3 color = deepColor;
        color *= (0.82+cloud*0.27+small*0.07)*colorFilter;
        color *= mix(0.65,1.2,dot(tint,vec3(0.2126,0.7152,0.0722)));
        color = mix(color,vec3(0.76,0.9,0.94),foam);
        material.baseColor = vec4(color,1.0);
        material.roughness = clamp(materialParams.roughness+foam*0.35,0.045,1.0);
        material.ior = materialParams.ior;
        material.thickness = materialParams.thickness*2.2;
        material.transmission = materialParams.transmission*0.45*(1.0-foam*0.9);
        material.absorption = materialParams.absorption*1.6;
        material.clearCoat = materialParams.clearCoat*(1.0-foam);
        material.clearCoatRoughness = materialParams.clearCoatRoughness;
    }
}
