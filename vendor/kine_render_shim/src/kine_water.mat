
material {
    name : "kine_water",
    shadingModel : lit,
    blending : transparent,
    refractionMode : screenspace,
    refractionType : solid,
    instanced : true,
    requires : [ uv0 ],
    variables : [ waterPlaneHeight ],
    parameters : [
        { type : float4[64], name : instanceColors },
        { type : float,  name : roughness },
        { type : float,  name : ior },
        { type : float,  name : thickness },
        { type : float,  name : transmission },
        { type : float,  name : time },
        { type : float,  name : waveScale },
        { type : float,  name : speed },
        { type : float,  name : strength },
        { type : float,  name : octaves },
        { type : float,  name : height },
        { type : float,  name : foamAmount },
        { type : float3, name : skyTint },
        { type : bool,   name : pinEdges },
        { type : bool,   name : hasContactDepth },
        { type : sampler2d, name : contactDepth },
        // Declared so the renderer's per-batch setup can set them: see
        // kine_apply_material_params's KINE_MAT_WATER branch. Filament treats
        // setParameter() on an undeclared name as a precondition violation
        // (utils::PreConditionPanic -> std::terminate), so a name set in C++
        // must exist here or drawing water aborts the process.
        { type : float3, name : absorption },
        { type : float,  name : clearCoat },
        { type : float,  name : clearCoatRoughness }
    ]
}

vertex {
    #include "kine_water_waves.glsl"

    void materialVertex(inout MaterialVertexInputs material) {
        vec2 p = (getUserWorldFromWorldMatrix() * material.worldPosition).xz;
        float time = materialParams.time * materialParams.speed;
        float scale = max(materialParams.waveScale, 0.25);
        vec2 warped;
        mat2 gradient;
        waterWaveWarp(p, scale, warped, gradient);
        material.waterPlaneHeight = vec4(material.worldPosition.y, 0.0, 0.0, 0.0);
        vec3 displacement = vec3(0.0);
        int count = int(clamp(materialParams.octaves,1.0,6.0));
        for (int i=0;i<count;++i) {
            vec2 d;
            float k, amplitude, horizontal, phase;
            waterWave(i, warped, time, scale, d, k, amplitude, horizontal, phase);
            float s = sin(phase), c = cos(phase);
            displacement += vec3(d.x*horizontal*c,amplitude*s,d.y*horizontal*c);
        }
        if (materialParams.pinEdges) {
            // Adjacent Parts can have different vertex spacing. Their outer
            // edges must meet even when the meshes cannot resolve the same waves.
            mat4 model = getWorldFromModelMatrix();
            vec2 size = vec2(length(model[0].xyz), length(model[2].xyz));
            vec2 edge = min(material.uv0, 1.0 - material.uv0) * size;
            vec2 fade = smoothstep(vec2(0.0), min(vec2(3.0), size * 0.25), edge);
            displacement *= fade.x * fade.y;
        }
        material.worldPosition.xyz += displacement;
    }
}

fragment {
    #include "kine_water_waves.glsl"
    #include "kine_water_wicked.glsl"

    mat2 waterPixelFootprint(vec3 position) {
        // Project a pixel onto the level water plane. Derivatives of the
        // displaced mesh jump at triangle edges, especially at grazing angles.
        mat4 worldFromView = getWorldFromViewMatrix();
        mat4 clipFromView = getClipFromViewMatrix();
        vec2 pixel = 2.0 * getResolution().zw / abs(vec2(clipFromView[0][0], clipFromView[1][1]));
        if (clipFromView[2].w != 0.0) {
            vec3 fromCamera = position - getWorldCameraPosition();
            pixel *= -dot(fromCamera, worldFromView[2].xyz);
        }
        vec3 view = getWorldViewVector();
        float elevation = max(abs(view.y), 0.001);
        vec2 slope = view.xz * (view.y < 0.0 ? -1.0 : 1.0) / elevation;
        return mat2(
            (worldFromView[0].xz - worldFromView[0].y * slope) * pixel.x,
            (worldFromView[1].xz - worldFromView[1].y * slope) * pixel.y
        );
    }

    float waterWaveVisibility(mat2 footprint, vec2 phaseGradient) {
        vec2 phaseWidth = abs(phaseGradient * footprint);
        return 1.0 - smoothstep(0.65, 2.8, phaseWidth.x + phaseWidth.y);
    }

    vec3 waterSurfaceNormal(vec2 p, float time, float scale, mat2 footprint, out float crest) {
        vec3 tangentX = vec3(1,0,0), tangentZ = vec3(0,0,1);
        crest = 0.0;
        vec2 warped;
        mat2 gradient;
        waterWaveWarp(p, scale, warped, gradient);
        int count = int(clamp(materialParams.octaves,1.0,6.0));
        for (int i=0; i<count; ++i) {
            vec2 d;
            float k, amplitude, horizontal, phase;
            waterWave(i, warped, time, scale, d, k, amplitude, horizontal, phase);
            vec2 phaseGradient = (gradient * d) * k;
            float weight = waterWaveVisibility(footprint, phaseGradient);
            if (weight <= 0.0) continue;
            float waveHeight = sin(phase) * weight;
            float slope = amplitude * cos(phase) * weight;
            vec2 horizontalSlope = -d * horizontal * waveHeight;
            vec3 derivative = vec3(horizontalSlope.x, slope, horizontalSlope.y);
            tangentX += phaseGradient.x * derivative;
            tangentZ += phaseGradient.y * derivative;
            crest += amplitude * waveHeight;
        }
        return normalize(cross(tangentZ, tangentX));
    }

    vec2 waterRipples(vec2 p, float time, mat2 footprint) {
        // Slow coherent flow breaks up straight wave bands without textures.
        vec2 flow = vec2(waterNoise(p*0.48+vec2(time*0.025,0.0)).x,
                         waterNoise(p*0.48+vec2(7.3,2.8-time*0.02)).x);
        p += (flow-0.5)*2.2;
        vec2 gradient = vec2(0);
        vec2 direction = normalize(vec2(1.0,0.38));
        float frequency = 1.45, amplitude = 0.12;
        int count = int(clamp(materialParams.octaves,1.0,32.0));
        for (int i=0; i<count; ++i) {
            float phase = dot(direction,p)*frequency + time*(0.7+float(i)*0.13);
            float visible = waterWaveVisibility(footprint, direction * frequency);
            gradient += direction*cos(phase)*amplitude*visible;
            p += direction*sin(phase)*0.035;
            direction = vec2(direction.x*0.7986-direction.y*0.6018,
                             direction.x*0.6018+direction.y*0.7986);
            frequency *= 1.75;
            amplitude *= 0.68;
        }
        return gradient;
    }

    float waterContactFoam(vec3 position) {
        if (!materialParams.hasContactDepth || materialParams.foamAmount <= 0.0) return 0.0;
        mat4 clipFromWorld = getClipFromWorldMatrix();
        mat4 worldFromClip = getWorldFromClipMatrix();
        vec4 center = clipFromWorld * vec4(position, 1.0);
        // Map the main view's padded projection to the unpadded depth capture.
        vec2 logicalUv = getNormalizedViewportCoord().xy;
        vec2 logicalScale = abs(vec2(dFdx(logicalUv.x), dFdy(logicalUv.y))) * getResolution().xy;
        const vec2 offsets[5] = vec2[](vec2(0, 0), vec2(0.65, 0), vec2(-0.65, 0),
                                         vec2(0, 0.65), vec2(0, -0.65));
        float nearest = 2.0;
        for (int i = 0; i < 5; ++i) {
            vec4 clip = clipFromWorld * vec4(position + vec3(offsets[i].x, 0.0, offsets[i].y), 1.0);
            if (clip.w <= 0.0) continue;
            vec2 ndc = clip.xy / clip.w;
            if (any(greaterThan(abs(ndc), vec2(1.0)))) continue;
            vec2 uv = logicalUv + (ndc - center.xy / center.w) * 0.5 * logicalScale;
            if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) continue;
            float depth = textureLod(materialParams_contactDepth, uvToRenderTargetUV(uv), 0.0).r;
            if (depth <= 0.0) continue;
            vec4 world = worldFromClip * vec4(ndc, depth, 1.0);
            vec3 separation = world.xyz / world.w - position;
            nearest = min(nearest, length(separation * vec3(1.0, 1.7, 1.0)));
            if (nearest <= 0.25) return 1.0;
        }
        return 1.0 - smoothstep(0.25, 1.35, nearest);
    }

    void material(inout MaterialInputs material) {
        float time = materialParams.time*materialParams.speed;
        float scale = max(materialParams.waveScale, 0.25);
        vec3 view = getWorldViewVector();
        vec3 position = getWorldPosition();
        // Sample along the view ray on the original water plane. Coarse or
        // overlapping displaced triangles can otherwise shift a highlight
        // sideways at their edges, even when the wave function is continuous.
        float elevation = abs(view.y);
        float toPlane = (variable_waterPlaneHeight.x - position.y) * sign(view.y) / max(elevation, 0.01);
        position += view * toPlane * smoothstep(0.01, 0.08, elevation);
        vec2 wavePosition = (getUserWorldFromWorldMatrix() * vec4(position, 1.0)).xz;
        mat2 footprint = waterPixelFootprint(position);
        vec2 p = wavePosition / scale;
        vec2 detail = waterRipples(p, time, footprint / scale);
        float crest;
        vec3 waveNormal = waterSurfaceNormal(wavePosition, time, scale, footprint, crest);
        float rippleStrength = min(materialParams.strength * materialParams.height, 2.0);
        vec3 N = normalize(waveNormal + vec3(-detail.x, 0.0, -detail.y) * rippleStrength);
        vec4 wicked = wickedWaterSurface(wavePosition, time, scale, footprint,
                length(position - getWorldCameraPosition()));
        vec3 wickedNormal = normalize(vec3(-wicked.x, 1.7, -wicked.y));
        N = normalize(mix(N, wickedNormal, 0.36 * (1.0 - wicked.w)));
        // Filament consumes normal in prepareMaterial, so assign it first.
        material.normal = transpose(getWorldTangentFrame())*N;
        material.clearCoatNormal = material.normal;
        prepareMaterial(material);

        float variation = waterNoise(p * 0.36 + vec2(time * 0.025, -time * 0.018)).x;
        float foamPatches = waterNoise(p * 0.19 + vec2(8.1, -4.4) + vec2(-0.06, 0.04) * time).x;
        float foam = smoothstep(0.19, 0.58, crest + (variation - 0.5) * 0.30);
        foam *= smoothstep(0.35, 0.72, foamPatches) * materialParams.foamAmount;
        float contact = waterContactFoam(getWorldPosition());
        float foldingFoam = wickedWaterFoam(wicked.z, contact, foamPatches, wicked.w);
        foam = max(foam, foldingFoam * materialParams.foamAmount);
        if (contact * materialParams.foamAmount > foam) {
            float bubbles = mix(0.45, 1.0, smoothstep(0.28, 0.73, waterNoise(p * 1.35 + vec2(time * 0.22, -time * 0.16)).x));
            foam = max(foam, contact * bubbles * materialParams.foamAmount);
        }

        vec4 instanceColor = materialParams.instanceColors[getInstanceIndex()];
        vec3 tint = saturate(instanceColor.rgb);
        vec3 colorFilter = mix(vec3(1.0), tint / max(max(tint.r, tint.g), max(tint.b, 0.001)), 0.35);
        vec3 waterColor = vec3(0.105, 0.19, 0.255) * colorFilter;
        waterColor *= mix(0.82, 1.16, dot(tint, vec3(0.2126, 0.7152, 0.0722)));
        waterColor *= mix(0.84, 1.16, variation);
        material.baseColor = vec4(mix(waterColor, vec3(0.62, 0.80, 0.88), foam), instanceColor.a);

        // A broad reflection of the bright horizon makes the bends in the
        // surface readable between the much sharper sun glints.
        float grazing = pow(1.0 - saturate(dot(N, view)), 3.0);
        float reflectedElevation = getWorldReflectedVector().y;
        float horizon = smoothstep(-0.12, 0.04, reflectedElevation);
        horizon *= 1.0 - smoothstep(0.09, 0.75, reflectedElevation);
        float crestLight = smoothstep(-0.06, 0.62, crest + (foamPatches - 0.5) * 0.15);
        crestLight *= mix(0.22, 1.0, smoothstep(0.18, 0.8, foamPatches));
        vec3 skySheen = materialParams.skyTint * (0.14 + grazing * horizon * mix(0.55, 2.2, crestLight));
        material.emissive = vec4(skySheen * (1.0 - foam), 0.0);

        material.roughness = clamp(wickedWaterAngularRoughness(N, view, materialParams.roughness) +
                foam * 0.32, 0.025, 1.0);
        material.ior = materialParams.ior;
        material.thickness = materialParams.thickness*2.2;
        material.transmission = materialParams.transmission * 0.56 * (1.0 - foam * 0.9);
        material.absorption = materialParams.absorption;
        material.clearCoat = materialParams.clearCoat*(1.0-foam);
        material.clearCoatRoughness = materialParams.clearCoatRoughness;
    }
}
