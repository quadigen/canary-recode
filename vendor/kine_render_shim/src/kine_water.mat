
material {
    name : "kine_water",
    shadingModel : lit,
    blending : transparent,
    refractionMode : screenspace,
    refractionType : solid,
    instanced : true,
    requires : [ uv0 ],
    // Custom interpolant carrying the world-space Gerstner normal from the
    // vertex stage to the fragment stage (drives shading + crest foam).
    variables : [ worldWaveNormal ],
    parameters : [
        { type : float4[64], name : instanceColors },
        { type : float,  name : roughness },
        { type : float,  name : ior },
        { type : float,  name : thickness },
        { type : float,  name : transmission },
        { type : float,  name : time },
        { type : float,  name : waveScale },
        { type : float,  name : waveSpeed },
        { type : float,  name : waveAmplitude },
        { type : float,  name : foamAmount },
        // Declared so the renderer's per-batch setup can set them: see
        // kine_apply_material_params's KINE_MAT_WATER branch. Filament treats
        // setParameter() on an undeclared name as a precondition violation
        // (utils::PreConditionPanic -> std::terminate), so a name set in C++
        // must exist here or drawing water aborts the process.
        { type : float3, name : absorption },
        { type : float,  name : clearCoat },
        { type : float,  name : clearCoatRoughness }
    ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        // True world-space position of the undisplaced vertex. Wave phases are
        // a function of world XZ, so every chunk/instance of the same ocean
        // tiles seamlessly and stays put as the camera moves.
        vec3 baseWorld = (getWorldFromModelMatrix() * vec4(getPosition().xyz, 1.0)).xyz;
        float t   = materialParams.time * materialParams.waveSpeed;
        float amp = materialParams.waveAmplitude;

        // Steepness per wave stays below the sum-of-Q <= 1 loop-avoidance
        // bound so overlapping crests never fold over themselves.
        vec2 dxz = vec2(0.0);
        float dy = 0.0;
        vec3 dTx = vec3(1.0, 0.0, 0.0);
        vec3 dTz = vec3(0.0, 0.0, 1.0);

        // Gerstner wave: displacement + partial derivatives.
        // Args: direction, steepness, wavelength, phase speed.
        #define KINE_GERSTNER(DIR, STEEPNESS, WAVELENGTH, PHASE_SPEED)   \
        {                                                                \
            vec2 D = normalize(DIR);                                     \
            float k = 6.2831853 / (WAVELENGTH);                          \
            float f = k * dot(D, baseWorld.xz) + (PHASE_SPEED) * t;      \
            float S = (STEEPNESS) * amp;                                 \
            float sf = sin(f);                                           \
            float cf = cos(f);                                           \
            dxz += D * (S / k) * cf;                                     \
            dy  += (S / k) * sf;                                         \
            dTx += vec3(-D.x * D.x * S * sf,                             \
                         D.x * S * cf,                                   \
                        -D.x * D.y * S * sf);                            \
            dTz += vec3(-D.x * D.y * S * sf,                             \
                         D.y * S * cf,                                   \
                        -D.y * D.y * S * sf);                            \
        }

        // Primary swell.
        KINE_GERSTNER(vec2( 1.0,  0.2), 0.16, 18.0, 1.4);
        KINE_GERSTNER(vec2(-0.4,  1.0), 0.12, 11.0, 1.9);
        // Cross chop.
        KINE_GERSTNER(vec2( 0.8, -0.6), 0.07,  4.5, 2.8);
        KINE_GERSTNER(vec2(-0.6, -0.8), 0.05,  2.2, 3.6);

        // The default worldPosition is expressed camera-relative for
        // precision; a displacement offset is translation-invariant, so
        // adding it is correct in that space.
        material.worldPosition.xyz += vec3(dxz.x, dy, dxz.y);

        // Analytic normal of the displaced surface. With T = dP/dX and
        // B = dP/dZ and the undisturbed height constant along Y, N = B x T
        // is unit-up on a flat sea and follows every crest and trough.
        vec3 N = normalize(cross(dTz, dTx));
        material.worldWaveNormal = vec4(N, 0.0);
    }
}

fragment {
// Accumulates the 2D surface gradient of a small fan of directional sine
// waves over world XZ; used as an x/y normal perturbation this is equivalent
// to shading a heightfield. phaseSkew decorrelates the two sample sets.
vec2 kineRippleGradient(vec2 xz, float t, float phaseSkew) {
    vec2 gradient = vec2(0.0);
    float amplitude = 0.30;
    float frequency = 2.4;
    vec2 direction = normalize(vec2(1.0, 0.35));
    for (int i = 0; i < 4; i++) {
        float phase = dot(direction, xz) * frequency + t * (1.1 + float(i) * 0.35) + phaseSkew;
        gradient += direction * (frequency * amplitude * cos(phase));
        direction = vec2(direction.x * 0.7986 - direction.y * 0.6018,
                         direction.x * 0.6018 + direction.y * 0.7986);
        frequency *= 1.9;
        amplitude *= 0.58;
    }
    return gradient;
}

void material(inout MaterialInputs material) {
    prepareMaterial(material);

    float t = materialParams.time * materialParams.waveSpeed;

    // Small-scale ripples: the surface gradient of two decorrelated octave
    // fans scrolling across world XZ at different scales. (getUV0 is
    // world-mapped for water meshes, i.e. uv * uvScale == world XZ.)
    vec2 xz1 = getUV0() * materialParams.waveScale * 1.05 + t * vec2( 0.11,  0.045);
    vec2 xz2 = getUV0() * materialParams.waveScale * 3.20 - t * vec2(-0.041,  0.13);

    vec2 detail = kineRippleGradient(xz1, t, 0.0)
                + kineRippleGradient(xz2, t, 2.3);

    // Final world-space surface normal: Gerstner normal from the vertex stage
    // perturbed by the ripple gradient. Then into tangent space for
    // material.normal (the TBN is orthonormal, from generated mesh tangents).
    vec3 waveNormal = normalize(variable_worldWaveNormal.xyz);
    vec3 N = normalize(waveNormal + vec3(detail.x, 0.0, detail.y) * 0.35);

    mat3 tbn = getWorldTangentFrame();
    material.normal = transpose(tbn) * N;

    material.baseColor.rgb = materialParams.instanceColors[getInstanceIndex()].rgb;
    material.roughness     = materialParams.roughness;
    material.ior           = materialParams.ior;
    material.thickness     = materialParams.thickness;
    material.transmission  = materialParams.transmission;

    // Beer-Lambert extinction through the water body: a warm-channel-heavy
    // coefficient (red absorbs fastest) is what gives depth its blue/green
    // falloff instead of a flat tint.
    material.absorption = materialParams.absorption;

    // A crisp secondary specular lobe, dimmed where foam breaks the surface.
    material.clearCoat          = materialParams.clearCoat;
    material.clearCoatRoughness = materialParams.clearCoatRoughness;

    // Foam: wave crests are where the displaced surface tips away from up.
    // Blend the geometric slope of the Gerstner normal with a little of the
    // ripple noise so the foam breaks up instead of tracing a perfect band.
    float crest = 1.0 - saturate(waveNormal.y);
    float foamMask = smoothstep(0.015, 0.10, crest + detail.x * 0.03);
    foamMask *= materialParams.foamAmount;
    material.baseColor.rgb = mix(material.baseColor.rgb, vec3(1.0), foamMask);

    material.baseColor.a = 1.0;
}
}
