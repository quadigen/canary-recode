material {
    name : "KineTerrainRaymarch",
    shadingModel : lit,
    blending : opaque,
    culling : front,
    depthWrite : true,
    instanced : true,
    variables : [ brickOrigin, brickExit ],
    parameters : [
        { type : sampler3d, name : samples, precision : high },
        { type : float3, name : boundsMin },
        { type : float3, name : boundsMax },
        { type : float3, name : sampleOrigin },
        { type : float3, name : invSampleSize },
        { type : float, name : voxelSize },
        { type : float, name : isoLevel }
    ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        material.brickOrigin.xyz = getWorldFromModelMatrix()[3].xyz;
        material.brickExit.xyz = getPosition().xyz / materialParams.voxelSize;
    }
}

fragment {
    highp vec4 terrainSample(highp vec3 p) {
        highp vec3 uv = (p - materialParams.sampleOrigin + 0.5) * materialParams.invSampleSize;
        return textureLod(materialParams_samples, uv, 0.0);
    }

    highp float terrainDistance(highp vec3 p) {
        return materialParams.isoLevel - terrainSample(p).r;
    }

    // The box's back face provides coverage even when the eye or near plane
    // lies inside the brick. March only the part of the ray owned by this brick.
    bool terrainHit(highp vec3 exitPoint, highp vec3 nearPoint, highp vec3 ray,
                    out highp vec3 hit) {
        highp vec3 raySign = mix(vec3(-1.0), vec3(1.0), greaterThanEqual(ray, vec3(0.0)));
        highp vec3 safeRay = raySign * max(abs(ray), vec3(1e-6));
        highp vec3 entryPlane = mix(materialParams.boundsMax, materialParams.boundsMin,
                                    greaterThan(ray, vec3(0.0)));
        highp vec3 entry = (entryPlane - exitPoint) / safeRay;
        entry = mix(entry, vec3(-64.0), lessThan(abs(ray), vec3(1e-6)));
        highp float t = max(max(entry.x, max(entry.y, entry.z)), dot(nearPoint - exitPoint, ray));
        highp float field = terrainDistance(exitPoint + t * ray);
        bool inAir = field > 0.0;
        // Trilinear occupancy is bounded to [0, 1] on a unit lattice. The
        // sum of the absolute ray components bounds its directional change.
        highp float invSlope = 1.0 / dot(abs(ray), vec3(1.0));
        for (int stepIndex = 0; stepIndex < 224 && t < 0.0; ++stepIndex) {
            highp float next = min(0.0, t + max(abs(field) * invSlope, 0.125));
            field = terrainDistance(exitPoint + next * ray);
            if ((field > 0.0) != inAir) {
                for (int i = 0; i < 7; ++i) {
                    highp float mid = (t + next) * 0.5;
                    if ((terrainDistance(exitPoint + mid * ray) > 0.0) == inAir) {
                        t = mid;
                    } else {
                        next = mid;
                    }
                }
                hit = exitPoint + (t + next) * 0.5 * ray;
                return true;
            }
            t = next;
        }
        return false;
    }

    vec3 terrainNormal(highp vec3 p, highp vec3 ray) {
        const vec2 e = vec2(0.4, 0.0);
        vec3 gradient = vec3(
            terrainDistance(p + e.xyy) - terrainDistance(p - e.xyy),
            terrainDistance(p + e.yxy) - terrainDistance(p - e.yxy),
            terrainDistance(p + e.yyx) - terrainDistance(p - e.yyx));
        return dot(gradient, gradient) > 1e-8 ? normalize(gradient) : -ray;
    }

    float terrainOccupied(highp vec3 p) {
        highp float iso = materialParams.isoLevel;
        return smoothstep(iso, min(iso + 0.16, 1.0001), terrainSample(p).r);
    }

    float terrainOcclusion(highp vec3 p, vec3 normal) {
        vec3 reference = abs(normal.y) < 0.95 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
        vec3 tangent = normalize(cross(reference, normal));
        vec3 bitangent = cross(normal, tangent);
        highp vec3 center = p + 0.66 * normal;
        float occupied = terrainOccupied(center + 1.25 * tangent)
                       + terrainOccupied(center - 1.25 * tangent)
                       + terrainOccupied(center + 1.25 * bitangent)
                       + terrainOccupied(center - 1.25 * bitangent);
        occupied += 2.0 * terrainOccupied(p + 1.35 * normal);
        return clamp(1.0 - occupied * 0.19, 0.25, 1.0);
    }

#if defined(VARIANT_HAS_SHADOWING) && !defined(VARIANT_DEPTH)
    float shadow(const bool directional, const mediump sampler2DArrayShadow map,
                 const int index, highp vec4 position, highp float zLight);
    float shadow(const bool directional, const highp sampler2DArray map,
                 const int index, highp vec4 position, highp float zLight);

    float terrainSunVisibility(highp vec3 world, vec3 normal) {
        if ((frameUniforms.directionalShadows & 1) == 0 ||
            dot(normal, frameUniforms.lightDirection) <= 0.0) return 1.0;
        int cascade = getShadowCascade();
        if ((frameUniforms.cascades & (1 << (cascade + 8))) == 0) return 1.0;

        // Filament normally interpolates cascade zero's coordinates at the
        // vertices. Project the ray hit into the shadow map instead.
        highp vec4 position = computeLightSpacePosition(world, normal, frameUniforms.lightDirection,
            shadowUniforms.shadows[cascade].normalBias,
            shadowUniforms.shadows[cascade].lightFromWorldMatrix);
        return shadow(true, sampler0_shadowMap, cascade, position, 0.0);
    }
#endif

    void material(inout MaterialInputs material) {
        highp vec2 screen = vertex_position.xy / vertex_position.w;
        highp vec4 nearWorld = getWorldFromClipMatrix() * vec4(screen, 1.0, 1.0);
        highp vec3 origin = variable_brickOrigin.xyz;
        highp vec3 nearPoint = (nearWorld.xyz / nearWorld.w - origin) / materialParams.voxelSize;
        highp vec3 exitPoint = variable_brickExit.xyz;
        highp vec3 ray = normalize(exitPoint - nearPoint);
        highp vec3 hit;
        if (!terrainHit(exitPoint, nearPoint, ray, hit)) discard;

        highp vec3 world = origin + hit * materialParams.voxelSize;
        highp vec4 clip = getClipFromWorldMatrix() * vec4(world, 1.0);
        gl_FragDepth = clamp(clip.z / clip.w, 0.0, 1.0);

#if !defined(VARIANT_DEPTH)
        vec3 normal = terrainNormal(hit, ray);
        // The proxy is solely for coverage. Lighting and fog use the hit.
        shading_position = world;
        shading_view = -ray;
        material.normal = transpose(getWorldTangentFrame()) * normal;
        prepareMaterial(material);
        shading_geometricNormal = normal;

        highp vec4 surface = terrainSample(hit);
        vec3 albedo = surface.gba / max(surface.r, 0.001);
        float ao = terrainOcclusion(hit, normal);
        float shadowLight = 1.0;
#if defined(VARIANT_HAS_SHADOWING)
        shadowLight = mix(0.59, 1.0, terrainSunVisibility(world, normal));
#endif
        material.baseColor = vec4(albedo * shadowLight * mix(0.74, 1.0, ao), 1.0);
        material.ambientOcclusion = ao;
        material.roughness = 0.88;
        material.shadowStrength = 0.0;
#endif
    }
}
