// Volumetric cloud layer.
//
// The layer is an infinite horizontal slab: only its bottom and top are bounded,
// so there is no edge to fly towards. A small quad is placed on the camera's far
// plane each frame and the fragment shader marches the ray from the eye through
// the slab. Because the quad sits at the far plane it is depth-tested against
// every opaque object, which is what keeps terrain and parts in front of the
// clouds, and there is no volume boundary that can clip near the horizon.
material {
    name : kine_cloud,
    shadingModel : unlit,
    blending : transparent,
    depthWrite : false,
    culling : none,
    parameters : [
        // Seconds, from the engine clock.
        { type : float,  name : time },
        // Sky coverage 0..1: higher values leave fewer holes between clumps.
        { type : float,  name : cover },
        // Thickness 0..1: extinction through the slab.
        { type : float,  name : density },
        // Weight of the high frequency octaves (wispy edges).
        { type : float,  name : detail },
        // World units per noise feature.
        { type : float,  name : noiseScale },
        { type : float,  name : absorption },
        { type : float,  name : scattering },
        { type : float,  name : windSpeed },
        // Slab centre in camera-relative space (XZ is always the eye's) and its
        // half thickness. This is the whole volume: X and Z are unbounded.
        { type : float3, name : slabCentre },
        { type : float,  name : halfThickness },
        // Camera position in world space, so the noise stays pinned to the
        // world while the proxy quad follows the camera.
        { type : float3, name : cameraPosition },
        { type : float3, name : sunDirection },
        { type : float3, name : sunColor },
        { type : float3, name : cloudColor }
    ]
}

fragment {
    #define CLOUD_MAX_STEPS 32
    // Geometric march: fine steps near the eye, coarse far away, so an
    // unbounded layer still resolves detail overhead and stays cheap at the
    // horizon.
    #define CLOUD_STEP_BASE 6.0
    #define CLOUD_STEP_GROWTH 1.12
    #define CLOUD_MAX_DISTANCE 9000.0

    float cloudHash(vec3 p) {
        p = fract(p * 0.3183099 + vec3(0.1, 0.1, 0.1));
        p *= 17.0;
        return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
    }

    float cloudNoise(vec3 x) {
        vec3 i = floor(x);
        vec3 f = fract(x);
        f = f * f * (3.0 - 2.0 * f);
        return mix(
            mix(
                mix(cloudHash(i + vec3(0.0, 0.0, 0.0)), cloudHash(i + vec3(1.0, 0.0, 0.0)), f.x),
                mix(cloudHash(i + vec3(0.0, 1.0, 0.0)), cloudHash(i + vec3(1.0, 1.0, 0.0)), f.x),
                f.y),
            mix(
                mix(cloudHash(i + vec3(0.0, 0.0, 1.0)), cloudHash(i + vec3(1.0, 0.0, 1.0)), f.x),
                mix(cloudHash(i + vec3(0.0, 1.0, 1.0)), cloudHash(i + vec3(1.0, 1.0, 1.0)), f.x),
                f.y),
            f.z);
    }

    // 0..1 density at a camera-relative world position.
    float slabDensity(vec3 p) {
        // Reject samples outside the slab before evaluating the noise octaves.
        float local = abs(p.y - materialParams.slabCentre.y) / max(materialParams.halfThickness, 0.001);
        if (local >= 1.0) return 0.0;
        float vertical = 1.0 - smoothstep(0.88, 1.0, local);
        float scale = max(materialParams.noiseScale, 1.0);
        float t = materialParams.time * max(materialParams.windSpeed, 0.0);

        // Sampling in world space keeps the pattern still while the proxy
        // quad slides with the camera.
        vec3 world = p + materialParams.cameraPosition;
        vec3 q = world / scale + vec3(t * 0.030, t * 0.006, -t * 0.014);

        float f = 0.0;
        float amp = 0.5;
        for (int i = 0; i < 3; i++) {
            float weight = i < 2 ? 1.0 : mix(0.25, 1.0, clamp(materialParams.detail, 0.0, 1.0));
            f += amp * weight * cloudNoise(q);
            q = q * 2.03 + vec3(1.7, 9.2, 3.1);
            amp *= 0.5;
        }

        // Cover moves the threshold, so more cover means fewer holes. The ramp
        // is wide: a hard threshold reads as a flat cut-out instead of a volume.
        float threshold = mix(0.70, 0.26, clamp(materialParams.cover, 0.0, 1.0));
        float d = smoothstep(threshold, threshold + 0.32, f);

        return d * vertical;
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        vec3 rayOrigin = getWorldCameraPosition();
        vec3 rayDir = normalize(getWorldPosition() - rayOrigin);

        float bottom = materialParams.slabCentre.y - materialParams.halfThickness;
        float top = materialParams.slabCentre.y + materialParams.halfThickness;

        float tEnter, tExit;
        if (abs(rayDir.y) < 1e-5) {
            // A level ray only meets the slab if the eye is already inside it.
            if (rayOrigin.y < bottom || rayOrigin.y > top) {
                material.baseColor = vec4(0.0);
                return;
            }
            tEnter = 0.0;
            tExit = CLOUD_MAX_DISTANCE;
        } else {
            tEnter = (bottom - rayOrigin.y) / rayDir.y;
            tExit = (top - rayOrigin.y) / rayDir.y;
            if (tEnter > tExit) {
                float swap = tEnter;
                tEnter = tExit;
                tExit = swap;
            }
        }

        tEnter = max(tEnter, 0.0);
        tExit = min(tExit, CLOUD_MAX_DISTANCE);
        if (tExit <= tEnter) {
            material.baseColor = vec4(0.0);
            return;
        }

        vec3 cloudColor = materialParams.cloudColor;
        vec3 shadowColor = cloudColor * vec3(0.52, 0.59, 0.75);
        vec3 sun = normalize(materialParams.sunDirection);
        vec3 sunColor = materialParams.sunColor;

        float sigmaScale =
                mix(0.4, 6.0, clamp(materialParams.density, 0.0, 1.0)) /
                max(materialParams.halfThickness * 2.0, 1.0);
        float lightStep = max(materialParams.halfThickness * 0.6, 1.0);

        // Dither the first sample so the fixed step count does not stamp rings.
        float jitter = cloudHash(vec3(gl_FragCoord.xy, fract(materialParams.time) * 97.0));

        float transmittance = 1.0;
        vec3 accum = vec3(0.0);
        float t = tEnter + CLOUD_STEP_BASE * jitter;
        float stepLen = CLOUD_STEP_BASE;

        for (int i = 0; i < CLOUD_MAX_STEPS; i++) {
            if (transmittance < 0.02 || t > tExit) {
                break;
            }

            vec3 p = rayOrigin + rayDir * t;
            float localDensity = slabDensity(p);
            if (localDensity > 0.0) {
                // Midpoint sample over the short sunward segment.
                float opticalDepth = slabDensity(p + sun * lightStep) * (2.0 * lightStep);
                float sunTransmit = exp(-opticalDepth * sigmaScale * materialParams.absorption);
                float powder = 1.0 - exp(-opticalDepth * sigmaScale * 2.0);

                vec3 lit = mix(shadowColor, cloudColor * sunColor, sunTransmit);
                lit *= mix(0.65, 1.0, powder);

                float sigma = localDensity * sigmaScale * materialParams.scattering;
                float extinction = exp(-sigma * stepLen);
                accum += transmittance * (1.0 - extinction) * lit;
                transmittance *= extinction;
            }

            t += stepLen;
            stepLen *= CLOUD_STEP_GROWTH;
        }

        material.baseColor = vec4(accum, 1.0 - transmittance);
    }
}
